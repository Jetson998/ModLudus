MODLUDUS_WEB_IMAGE=modludus-web:sha-REPLACE
MODLUDUS_API_IMAGE=modludus-api:sha-REPLACE
MODLUDUS_WEB_PORT=3100
MODLUDUS_API_PORT=8100
MODLUDUS_WEB_ORIGINS=https://modludus.152.32.172.162.sslip.io
MODLUDUS_EVIDENCE_SALT=replace-with-random-server-salt
MODLUDUS_TRUSTED_ENVIRONMENT=staging
MODLUDUS_TRUSTED_SIMULATED=false
MODLUDUS_ENABLE_ANONYMOUS_CONTRIBUTIONS=false
MODLUDUS_ADMIN_TOKEN=replace-with-random-admin-token
MODLUDUS_REVIEWER_TOKEN=replace-with-random-reviewer-token
MODLUDUS_TRUSTED_CONFIG_JSON=
MODLUDUS_JOB_LEASE_SECONDS=60
MODLUDUS_WORKER_POLL_SECONDS=1
MODLUDUS_BACKUP_DIR=/opt/modludus/backups
MODLUDUS_RESTORE_DIR=/opt/modludus/restore
